# ==============================================================================
# Bennett Hatchery IPMS — Environment Configuration
# ==============================================================================

# Database Configuration (Neon PostgreSQL)
# DATABASE_URL: Pooled connection string (pgbouncer) for runtime API execution
# DIRECT_URL: Direct unpooled connection string for Prisma migrations
DATABASE_URL="postgresql://neondb_owner:password@ep-sample-pooler.ap-south-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://neondb_owner:password@ep-sample.ap-south-1.aws.neon.tech/neondb?sslmode=require"

# Application Configuration
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Authentication & Session Configuration
# SESSION_SECRET: Minimum 32-character random string for cryptographic operations
SESSION_SECRET="change-this-to-a-very-secure-random-secret-in-production-min-32-chars"
SESSION_MAX_AGE="604800"

# Administrative & Rate Limiting Controls
RATE_LIMIT_MAX_ATTEMPTS="10"

